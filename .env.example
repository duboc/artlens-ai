# ArtLens AI — Environment Variables
# Copy to .env and fill in values, or run ./scripts/setup.sh to auto-configure.

# ─── Required ────────────────────────────────────────────────────────────────

# GCP project ID (used for Vertex AI, Firestore, Cloud Storage)
GOOGLE_CLOUD_PROJECT=your-project-id

# Cloud Storage bucket for images (selfies, scans, generated images)
GCS_BUCKET=your-project-id-artlens-media

# ─── Optional (have defaults) ───────────────────────────────────────────────

# Firestore database name (default: (default)). Use a dedicated database so
# resetting ArtLens data never touches other apps in the project.
# FIRESTORE_DATABASE=artlens

# Museum profile (see museums/index.ts): reina-sofia | mnac | generic (default)
# Visitors can override for testing with ?museum=<id> in the URL.
# MUSEUM_ID=reina-sofia

# Express server port (default: 3001)
# PORT=3001

# Vertex AI model overrides (models are always chosen server-side)
# MODEL_TEXT=gemini-3.5-flash-lite
# MODEL_TEXT_FALLBACK=gemini-3.8-flash
# MODEL_IMAGE=gemini-3.1-flash-image
# MODEL_LIVE=gemini-3.8-live

# Thinking level for text calls: MINIMAL | LOW | MEDIUM | HIGH (empty = model default)
# THINKING_LEVEL=LOW

# Timeout for a single Vertex AI REST call, in ms (image generation gets 2x)
# VERTEX_TIMEOUT_MS=45000

# Vertex AI region overrides
# VERTEX_REGION_TEXT=global
# VERTEX_REGION_IMAGE=global
# VERTEX_REGION_LIVE=us-central1

# CORS allowed origins (comma-separated, set after first deploy)
# ALLOWED_ORIGINS=https://artlens-ai-xxxxx.run.app,http://localhost:3000

# ─── Cloud Run Deploy (used by ./deploy.sh only) ────────────────────────────

# Cloud Run service name (default: artlens-ai)
# CLOUD_RUN_SERVICE=artlens-ai

# Cloud Run deploy region (default: us-central1)
# CLOUD_RUN_REGION=us-central1

# Max Cloud Run instances (default: 10)
# CLOUD_RUN_MAX_INSTANCES=10

# Runtime service account (default: Compute Engine default SA)
# CLOUD_RUN_SERVICE_ACCOUNT=artlens-run@your-project-id.iam.gserviceaccount.com
